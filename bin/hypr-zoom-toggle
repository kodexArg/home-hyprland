#!/usr/bin/env bash
# Toggle ASUS (left) scale 1.0 (roomy) ↔ 1.5 (dense) in either portrait (transform 1)
# or landscape (transform 0) layout.
#
# FSM (same contract as AGS caffeine):
#   SSOT reality = hyprctl monitors (scale, transform + x of ASUS output)
#   phases: dense (1.5) | arming | roomy (1.0) | failed
#   apply is sequential with settle delay — NEVER hyprctl --batch two
#   hl.monitor() calls. Aquamarine: "Cannot commit when a page-flip is
#   awaiting" → half layout / pantalla cortada.
#
set -euo pipefail

PORTRAIT="$(/home/kodex/.local/bin/hypr-output portrait 2>/dev/null || echo HDMI-A-2)"
LANDSCAPE="$(/home/kodex/.local/bin/hypr-output landscape 2>/dev/null || echo HDMI-A-1)"
GAP_SEC=0.55
MODE_PORTRAIT="1920x1080@100.05"
MODE_LANDSCAPE="1920x1080@99.93"
WALLPAPER="/home/kodex/home-hyprland/wallpapers/disco-elysium-thought-cabinet-art-cropped.avif"
LOG="${XDG_RUNTIME_DIR:-/tmp}/hypr-zoom.log"
STATE="${XDG_RUNTIME_DIR:-/tmp}/hypr-zoom.phase"

log() { printf '%s %s\n' "$(date -Iseconds)" "$*" >>"$LOG"; }

notify() {
  hyprctl notify 5 2000 0 "fontsize:14 $1" >/dev/null 2>&1 || true
}

resync_layers() {
  log "resync wallpaper"
  hyprctl hyprpaper wallpaper "${LANDSCAPE},${WALLPAPER},cover" >/dev/null 2>&1 || true
  hyprctl hyprpaper wallpaper "${PORTRAIT},${WALLPAPER},cover" >/dev/null 2>&1 || true
  sleep 0.15

  log "resync ags restart"
  if systemctl --user cat ags-hyprland.service >/dev/null 2>&1; then
    systemctl --user reset-failed ags-hyprland.service 2>/dev/null || true
    systemctl --user restart ags-hyprland.service 2>/dev/null || true
  else
    ags quit 2>/dev/null || true
    pkill -x ags 2>/dev/null || true
    sleep 0.2
    env PATH="/home/kodex/.local/bin:/usr/local/bin:/usr/bin" GSK_RENDERER=gl \
      /usr/local/bin/ags run /home/kodex/.config/ags \
      >>"${XDG_RUNTIME_DIR:-/tmp}/ags-zoom-restart.log" 2>&1 &
    disown || true
  fi

  local i
  for i in $(seq 1 40); do
    if /usr/local/bin/ags request bar-mode >/dev/null 2>&1; then
      log "ags up after ${i} tries"
      return 0
    fi
    sleep 0.1
  done
  log "ags restart: IPC not up yet (bar may appear late)"
}

# Prints: scale transform x y
portrait_geo() {
  hyprctl monitors -j | PORTRAIT="$PORTRAIT" python3 -c '
import json, os, sys
name = os.environ["PORTRAIT"]
for m in json.load(sys.stdin):
    if m.get("name") == name:
        print(float(m.get("scale", 1.0)), int(m.get("transform", 0)), int(m.get("x", 0)), int(m.get("y", 0)))
        raise SystemExit
print(1.5, 1, -720, 0)
'
}

is_dense_scale() {
  awk -v s="$1" 'BEGIN { exit !(s+0 >= 1.25) }'
}

apply_one() {
  local lua="$1"
  local out
  out=$(hyprctl eval "$lua" 2>&1) || true
  log "eval → $out | $lua"
  [[ "$out" == *ok* ]] || return 1
  # Wait for page-flip; fixed sleep (no timer-as-control-flow elsewhere — DRM has no ready FD here)
  sleep "$GAP_SEC"
  return 0
}

set_portrait() {
  local pos="$1" scale="$2" transform="$3"
  apply_one "hl.monitor({ output = \"${PORTRAIT}\", mode = \"${MODE_PORTRAIT}\", position = \"${pos}\", scale = ${scale}, transform = ${transform} })"
}

set_landscape() {
  local pos="$1"
  apply_one "hl.monitor({ output = \"${LANDSCAPE}\", mode = \"${MODE_LANDSCAPE}\", position = \"${pos}\", scale = 1, transform = 0 })"
}

wake_landscape() {
  hyprctl dispatch dpms on "$LANDSCAPE" >/dev/null 2>&1 || true
}

apply_roomy() {
  local tr="$1"
  if [[ "$tr" -eq 1 ]]; then
    set_portrait "-1080x0" 1 1 || return 1
    set_landscape "0x420" || return 1
    wake_landscape
    local s t x y
    read -r s t x y <<<"$(portrait_geo)"
    if is_dense_scale "$s" || [[ "$x" -gt -1000 ]]; then
      log "verify roomy portrait FAIL scale=$s x=$x"
      return 1
    fi
  else
    set_portrait "-1920x0" 1 0 || return 1
    set_landscape "0x0" || return 1
    wake_landscape
    local s t x y
    read -r s t x y <<<"$(portrait_geo)"
    if is_dense_scale "$s" || [[ "$x" -gt -1700 ]]; then
      log "verify roomy landscape FAIL scale=$s x=$x"
      return 1
    fi
  fi
  hyprctl eval 'hl.config({ general = { border_size = 2 }, decoration = { rounding = 10 } })' >/dev/null 2>&1 || true
  return 0
}

apply_dense() {
  local tr="$1"
  if [[ "$tr" -eq 1 ]]; then
    set_portrait "-720x0" 1.5 1 || return 1
    set_landscape "0x100" || return 1
    wake_landscape
    local s t x y
    read -r s t x y <<<"$(portrait_geo)"
    if ! is_dense_scale "$s" || [[ "$x" -lt -900 ]]; then
      log "verify dense portrait FAIL scale=$s x=$x"
      return 1
    fi
  else
    set_portrait "-1280x0" 1.5 0 || return 1
    set_landscape "0x0" || return 1
    wake_landscape
    local s t x y
    read -r s t x y <<<"$(portrait_geo)"
    if ! is_dense_scale "$s" || [[ "$x" -lt -1500 || "$x" -gt -1100 ]]; then
      log "verify dense landscape FAIL scale=$s x=$x"
      return 1
    fi
  fi
  hyprctl eval 'hl.config({ general = { border_size = 1 }, decoration = { rounding = 7 } })' >/dev/null 2>&1 || true
  return 0
}

# Heal half-applied layouts before toggling.
heal_if_inconsistent() {
  local s t x y
  read -r s t x y <<<"$(portrait_geo)"
  if [[ "$t" -eq 1 ]]; then
    if is_dense_scale "$s" && [[ "$x" -lt -900 ]]; then
      log "heal: dense scale but roomy x=$x (portrait) → re-dense"
      apply_dense 1 || true
    elif ! is_dense_scale "$s" && [[ "$x" -gt -1000 ]]; then
      log "heal: roomy scale but dense x=$x (portrait) → re-roomy"
      apply_roomy 1 || true
    fi
  else
    if is_dense_scale "$s" && [[ "$x" -lt -1500 ]]; then
      log "heal: dense scale but roomy x=$x (landscape) → re-dense"
      apply_dense 0 || true
    elif ! is_dense_scale "$s" && [[ "$x" -gt -1700 ]]; then
      log "heal: roomy scale but dense x=$x (landscape) → re-roomy"
      apply_roomy 0 || true
    fi
  fi
}

# ─── FSM ────────────────────────────────────────────────────────────────────
read -r cur_s cur_t cur_x cur_y <<<"$(portrait_geo)"
log "toggle start scale=$cur_s transform=$cur_t pos=${cur_x},${cur_y}"
heal_if_inconsistent
read -r cur_s cur_t cur_x cur_y <<<"$(portrait_geo)"

if is_dense_scale "$cur_s"; then
  echo arming >"$STATE"
  if apply_roomy "$cur_t"; then
    echo roomy >"$STATE"
    log "phase=roomy (transform $cur_t)"
    resync_layers
    notify "zoom roomy · scale 1.0"
    echo "zoom: ${PORTRAIT} scale=1.0 (roomy)"
  else
    echo failed >"$STATE"
    log "failed→restore dense"
    notify "zoom fail · restoring dense"
    apply_dense "$cur_t" || true
    resync_layers
    echo dense >"$STATE"
    exit 1
  fi
else
  echo arming >"$STATE"
  if apply_dense "$cur_t"; then
    echo dense >"$STATE"
    log "phase=dense (transform $cur_t)"
    resync_layers
    notify "zoom dense · scale 1.5"
    echo "zoom: ${PORTRAIT} scale=1.5 (dense)"
  else
    echo failed >"$STATE"
    log "failed dense"
    notify "zoom fail"
    exit 1
  fi
fi

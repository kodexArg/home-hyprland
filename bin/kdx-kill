#!/usr/bin/env bash
# kdx-kill — stop user services, free ports and kill processes on debian-sid / Hyprland.
#
# Pattern: Facade over three Strategies (svc, port, proc), each on a stock Debian tool:
#   svc  → systemctl --user stop
#   port → ss -ltnup (owner PIDs) → proc strategy
#   proc → kill -TERM to the process tree, grace, kill -KILL to survivors (procps)
#
# Usage:
#   kdx-kill                 interactive fzf picker (AGS menu + SUPER+CTRL+K)
#   kdx-kill list            TSV: kind<TAB>id<TAB>label  (what the picker shows)
#   kdx-kill svc  UNIT       stop a systemd --user unit
#   kdx-kill port PORT       kill whatever listens on PORT (tcp/udp)
#   kdx-kill pid  PID        TERM the tree, KILL after grace
#   kdx-kill do   "<row>"    act on one `list` row (used by the picker)
#
# Env:
#   KDX_KILL_GRACE          seconds between TERM and KILL (default 3)
#   KDX_KILL_PROTECT_PROC   ERE over comm that is never killed
#   KDX_KILL_PROTECT_UNIT   ERE over unit names that are never stopped
#   KDX_KILL_NOTIFY=0       silence notify-send
#
# Exit: 0 done · 1 failed / still alive · 2 usage · 3 refused (protected)
set -uo pipefail

GRACE="${KDX_KILL_GRACE:-3}"
PROTECT_PROC="${KDX_KILL_PROTECT_PROC:-^(systemd|\(sd-pam\)|Hyprland|hyprland|ags|gjs|pipewire|pipewire-pulse|wireplumber|easyeffects|dbus-daemon|dbus-broker|dbus-broker-lau|Xwayland|xdg-desktop-por|xdg-document-po|xdg-permission-|gdm-wayland-ses|gdm-session-wor|kitty|sshd|agy|hypridle|hyprpaper|fzf|kdx-kill)$}"
PROTECT_UNIT="${KDX_KILL_PROTECT_UNIT:-^(ags-hyprland|pipewire|pipewire-pulse|wireplumber|filter-chain|easyeffects|dbus|dbus-broker|dconf|hypridle|gcr-ssh-agent|gnome-keyring-daemon|at-spi-dbus-bus|xdg-.*|dbus-.*|gvfs-.*)\.service$}"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

notify() {
  [[ "${KDX_KILL_NOTIFY:-1}" == "0" ]] && return 0
  command -v notify-send >/dev/null 2>&1 && notify-send -a kdx-kill "kdx-kill" "$1" 2>/dev/null || true
}
say() { printf '%s\n' "$*" >&2; }

# ── proc strategy ────────────────────────────────────────────────────────────
alive() { kill -0 "$1" 2>/dev/null && [[ "$(ps -o stat= -p "$1" 2>/dev/null)" != Z* ]]; }

ancestors() {  # this script's own chain: never kill the terminal hosting the picker
  local p=$$
  while [[ -n "$p" && "$p" -gt 1 ]]; do
    echo "$p"
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
  done
}

descendants() {
  local c
  for c in $(pgrep -P "$1" 2>/dev/null); do
    descendants "$c"
    echo "$c"
  done
}

proc_refusal() {  # prints a reason when PID must not be touched
  local pid="$1" comm
  [[ "$pid" =~ ^[0-9]+$ ]] || { echo "PID inválido: $pid"; return; }
  [[ "$pid" -le 1 ]] && { echo "PID $pid protegido"; return; }
  [[ " $(ancestors | tr '\n' ' ') " == *" $pid "* ]] && { echo "PID $pid es ancestro de kdx-kill"; return; }
  comm="$(ps -o comm= -p "$pid" 2>/dev/null)"
  [[ -z "$comm" ]] && return
  [[ "$comm" =~ $PROTECT_PROC ]] && echo "$comm ($pid) está protegido"
}

kill_pid() {
  local pid="$1" reason comm targets t deadline
  reason="$(proc_refusal "$pid")"
  [[ -n "$reason" ]] && { say "rechazado: $reason"; return 3; }
  alive "$pid" || { say "PID $pid ya no existe"; return 0; }
  comm="$(ps -o comm= -p "$pid" 2>/dev/null)"

  targets="$(descendants "$pid") $pid"
  for t in $targets; do kill -TERM "$t" 2>/dev/null; done

  deadline=$(( $(date +%s%N) + $(awk -v g="$GRACE" 'BEGIN{printf "%d", g*1000000000}') ))
  while (( $(date +%s%N) < deadline )); do
    local any=0
    for t in $targets; do alive "$t" && { any=1; break; }; done
    (( any )) || break
    sleep 0.1
  done

  local forced=0
  for t in $targets; do
    alive "$t" && { kill -KILL "$t" 2>/dev/null; forced=1; }
  done
  (( forced )) && sleep 0.2

  if alive "$pid"; then
    say "falló: $comm ($pid) sigue vivo"; notify "No pude matar $comm ($pid)"; return 1
  fi
  local how="TERM"; (( forced )) && how="KILL"
  say "ok: $comm ($pid) terminado con $how"
  notify "$comm ($pid) terminado ($how)"
}

# ── port strategy ────────────────────────────────────────────────────────────
port_pids() {
  ss -Hltnup 2>/dev/null \
    | awk -v p="$1" '{ n=split($5,a,":"); if (a[n]==p) print $0 }' \
    | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u
}

kill_port() {
  local port="$1" pids pid rc=0
  [[ "$port" =~ ^[0-9]+$ ]] || { say "puerto inválido: $port"; return 2; }
  pids="$(port_pids "$port")"
  [[ -z "$pids" ]] && { say "nada propio escucha en :$port"; return 1; }
  for pid in $pids; do kill_pid "$pid" || rc=$?; done
  return "$rc"
}

# ── svc strategy ─────────────────────────────────────────────────────────────
stop_svc() {
  local unit="$1"
  [[ "$unit" == *.* ]] || unit="$unit.service"
  [[ "$unit" =~ $PROTECT_UNIT ]] && { say "rechazado: $unit está protegido"; return 3; }
  if ! systemctl --user is-active --quiet "$unit"; then
    say "$unit no está activo"; return 0
  fi
  if systemctl --user stop "$unit"; then
    say "ok: $unit detenido"; notify "$unit detenido"
  else
    say "falló: systemctl --user stop $unit"; notify "No pude detener $unit"; return 1
  fi
}

# ── listing ──────────────────────────────────────────────────────────────────
list_rows() {
  systemctl --user list-units --type=service --state=running --no-legend --plain 2>/dev/null \
    | while read -r unit _ _ _ desc; do
        [[ "$unit" =~ $PROTECT_UNIT ]] && continue
        printf 'svc\t%s\t%s\n' "$unit" "$desc"
      done

  ss -Hltnup 2>/dev/null | awk '{
      n=split($5,a,":"); port=a[n]
      if (match($0, /\("[^"]+",pid=[0-9]+/)) {
        s=substr($0, RSTART+2, RLENGTH-2); split(s, b, "\",pid=")
        printf "port\t%s\t%s %s (pid %s)\n", port, $1, b[1], b[2]
      }
    }' | sort -t$'\t' -k2,2n -u

  local n=0
  while read -r pid rss cpu comm args; do
    [[ "$comm" =~ $PROTECT_PROC ]] && continue
    [[ "$pid" == "$$" ]] && continue
    printf 'proc\t%s\t%5d MB %5s%% %s — %.90s\n' "$pid" "$((rss / 1024))" "$cpu" "$comm" "$args"
    (( ++n >= 60 )) && break
  done < <(ps -u "$(id -u)" -o pid=,rss=,pcpu=,comm=,args= --sort=-rss 2>/dev/null)
  return 0
}

do_row() {
  local kind id
  kind="$(cut -f1 <<<"$1")"; id="$(cut -f2 <<<"$1")"
  case "$kind" in
    svc)  stop_svc "$id" ;;
    port) kill_port "$id" ;;
    proc) kill_pid "$id" ;;
    *)    say "fila inválida: $1"; return 2 ;;
  esac
}

preview_row() {
  local kind id
  kind="$(cut -f1 <<<"$1")"; id="$(cut -f2 <<<"$1")"
  case "$kind" in
    svc)  SYSTEMD_COLORS=1 systemctl --user status --no-pager -n 15 "$id" 2>&1 ;;
    port) ss -ltnup "( sport = :$id )" 2>&1
          for p in $(port_pids "$id"); do echo; ps -o pid,ppid,rss,etime,args -p "$p"; done ;;
    proc) ps -o pid,ppid,rss,pcpu,etime,args -p "$id" 2>&1
          echo; echo "hijos:"; for c in $(descendants "$id"); do ps -o pid=,comm= -p "$c"; done ;;
  esac
}

picker() {
  command -v fzf >/dev/null 2>&1 || { say "fzf no está instalado"; exit 1; }
  list_rows | fzf \
    --multi --delimiter=$'\t' --with-nth=1,2,3 --tabstop=6 \
    --header=$'ENTER mata · TAB marca varios · ESC sale\nsvc = systemctl --user stop · port = libera puerto · proc = TERM→KILL' \
    --prompt='kill> ' --layout=reverse --border \
    --preview="$SELF preview {}" --preview-window='down,40%,wrap' \
    --bind="enter:execute($SELF do-many {+f}; read -rsn1 -p '  [tecla para volver]')+reload($SELF list)+clear-selection" \
    --bind="ctrl-r:reload($SELF list)"
}

case "${1:-pick}" in
  pick)     picker ;;
  list)     list_rows ;;
  svc)      [[ $# -eq 2 ]] || exit 2; stop_svc "$2" ;;
  port)     [[ $# -eq 2 ]] || exit 2; kill_port "${2%%/*}" ;;
  pid)      [[ $# -eq 2 ]] || exit 2; kill_pid "$2" ;;
  do)       [[ $# -eq 2 ]] || exit 2; do_row "$2" ;;
  do-many)  rc=0; while IFS= read -r row; do do_row "$row" || rc=$?; done < "$2"; exit "$rc" ;;
  preview)  preview_row "$2" ;;
  -h|--help|help) sed -n '2,24p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *)        say "uso: kdx-kill [list|svc UNIT|port N|pid PID]"; exit 2 ;;
esac

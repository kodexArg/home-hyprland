#!/usr/bin/env bash
# kdx-bootstrap-zensid — ROOT part of the zensid Hyprland install (Debian 13 trixie).
#
# Idea shared with Sid/TUF, but zensid keeps its own system: trixie + trixie-backports
# only (no sid/testing pinning). Hyprland = newest build packaged for trixie
# (trixie-backports, 0.55.x). astal + ags built from source, latest stable, against
# trixie's GTK/gtk4-layer-shell, installed under /usr/local.
#
# Usage (from the invoking user's clone):
#   sudo ~/home-hyprland/bin/kdx-bootstrap-zensid            # everything
#   sudo ~/home-hyprland/bin/kdx-bootstrap-zensid apt        # only apt steps
#   sudo ~/home-hyprland/bin/kdx-bootstrap-zensid build      # only astal + ags
#   sudo ~/home-hyprland/bin/kdx-bootstrap-zensid dropins    # only systemd drop-ins
# Env overrides:
#   AGS_REF=v3.1.2     (default: newest vX.Y.Z tag of Aylur/ags at run time)
#   ASTAL_REF=<sha>    (default: Aylur/astal main HEAD — astal has no releases)
#   FORCE=1            rebuild astal/ags even if already installed
#
# Idempotent: re-running only re-applies what is missing. Never touches GDM's
# default session or GNOME packages — GNOME stays as GDM fallback session.
set -euo pipefail

PREFIX=/usr/local
LIBDIR_ARCH="$(dpkg-architecture -qDEB_HOST_MULTIARCH 2>/dev/null || echo x86_64-linux-gnu)"
SRC_ROOT=/usr/local/src/kdx-zensid
BACKPORTS_FILE=/etc/apt/sources.list.d/trixie-backports.sources
ENVD_FILE=/etc/environment.d/60-kdx-astal.conf

BACKPORTS_PKGS=(
  hyprland hypridle hyprlock hyprpaper hyprpolkitagent hyprlauncher
  hyprland-guiutils xdg-desktop-portal-hyprland uwsm ydotool
)
TRIXIE_PKGS=(
  # desktop helpers used by hypr-* / kdx-* / AGS
  kitty grim slurp wf-recorder wl-clipboard wtype socat jq playerctl brightnessctl
  fuzzel wofi nautilus pulseaudio-utils libnotify-bin python3-evdev qt6-wayland
  bluez network-manager ffmpeg
  fonts-dseg fonts-noto-color-emoji
  # astal + ags build deps
  git meson ninja-build valac valadoc gobject-introspection libgirepository1.0-dev
  libgtk-3-dev libgtk-layer-shell-dev libgtk-4-dev libgtk4-layer-shell-dev
  libwireplumber-0.5-dev libjson-glib-dev wayland-protocols
  golang-go gjs npm
)

log()  { printf '\033[1;33m[kdx-bootstrap-zensid]\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m[kdx-bootstrap-zensid] %s\033[0m\n' "$*" >&2; exit 1; }
as_user() { sudo -u "$TARGET_USER" -H env GOTOOLCHAIN=local "$@"; }

preflight() {
  [[ $EUID -eq 0 ]] || die "run with sudo (root needed)"
  TARGET_USER="${SUDO_USER:-kodex}"
  id "$TARGET_USER" >/dev/null 2>&1 || die "user $TARGET_USER not found"
  . /etc/os-release
  [[ "${VERSION_CODENAME:-}" == "trixie" ]] || die "zensid bootstrap is trixie-only (found ${VERSION_CODENAME:-?})"
  [[ -f /usr/share/wayland-sessions/gnome.desktop ]] || log "WARN: GNOME wayland session not found — fallback session missing"
}

step_apt() {
  if [[ ! -f $BACKPORTS_FILE ]]; then
    log "adding trixie-backports → $BACKPORTS_FILE"
    cat > "$BACKPORTS_FILE" <<SRC
Types: deb
URIs: http://deb.debian.org/debian
Suites: trixie-backports
Components: main non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
SRC
  else
    log "trixie-backports already configured"
  fi
  apt-get update
  log "installing from trixie-backports: ${BACKPORTS_PKGS[*]}"
  DEBIAN_FRONTEND=noninteractive apt-get install -y -t trixie-backports "${BACKPORTS_PKGS[@]}"
  log "installing from trixie"
  DEBIAN_FRONTEND=noninteractive apt-get install -y "${TRIXIE_PKGS[@]}"
}

latest_ags_tag() {
  git ls-remote --tags https://github.com/Aylur/ags 'v*' \
    | awk -F/ '{print $3}' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1
}

fetch_repo() { # url dir ref
  local url=$1 dir=$2 ref=$3
  if [[ ! -d $dir/.git ]]; then as_user git clone -q "$url" "$dir"; fi
  as_user git -C "$dir" fetch -q --tags origin
  as_user git -C "$dir" checkout -q --detach "$ref"
}

step_build() {
  install -d -o "$TARGET_USER" "$SRC_ROOT"
  local ags_ref="${AGS_REF:-$(latest_ags_tag)}"
  local astal_ref="${ASTAL_REF:-origin/main}"
  [[ -n $ags_ref ]] || die "could not resolve latest ags tag"

  # astal: io, gtk3, gtk4 (ags needs all three) + wireplumber (AGS bar uses AstalWp)
  fetch_repo https://github.com/Aylur/astal "$SRC_ROOT/astal" "$astal_ref"
  local astal_sha; astal_sha=$(git -C "$SRC_ROOT/astal" rev-parse --short HEAD)
  local stamp="$PREFIX/share/kdx-zensid/astal.sha"
  if [[ ${FORCE:-0} == 1 || ! -f $stamp || "$(cat "$stamp")" != "$astal_sha" ]]; then
    for lib in lib/astal/io lib/astal/gtk3 lib/astal/gtk4 lib/wireplumber; do
      log "building astal $lib @ $astal_sha"
      as_user meson setup --wipe --prefix="$PREFIX" "$SRC_ROOT/astal/$lib/build" "$SRC_ROOT/astal/$lib" \
        || as_user meson setup --prefix="$PREFIX" "$SRC_ROOT/astal/$lib/build" "$SRC_ROOT/astal/$lib"
      as_user meson compile -C "$SRC_ROOT/astal/$lib/build"
      meson install -C "$SRC_ROOT/astal/$lib/build"
      ldconfig
    done
    install -d "$PREFIX/share/kdx-zensid"; echo "$astal_sha" > "$stamp"
  else
    log "astal $astal_sha already installed"
  fi

  # typelibs under /usr/local are not on gjs' default search path
  install -d /etc/environment.d
  printf 'GI_TYPELIB_PATH=%s/lib/%s/girepository-1.0:/usr/lib/%s/girepository-1.0\n' \
    "$PREFIX" "$LIBDIR_ARCH" "$LIBDIR_ARCH" > "$ENVD_FILE"
  export GI_TYPELIB_PATH="$PREFIX/lib/$LIBDIR_ARCH/girepository-1.0"

  # ags (latest stable tag)
  local want="${ags_ref#v}" have=""
  have=$("$PREFIX/bin/ags" --version 2>/dev/null | awk '{print $NF}' || true)
  if [[ ${FORCE:-0} == 1 || "$have" != "$want" ]]; then
    fetch_repo https://github.com/Aylur/ags "$SRC_ROOT/ags" "$ags_ref"
    log "building ags $ags_ref (have: ${have:-none})"
    as_user bash -c "cd '$SRC_ROOT/ags' && npm install --no-audit --no-fund"
    as_user meson setup --wipe --prefix="$PREFIX" "$SRC_ROOT/ags/build" "$SRC_ROOT/ags" \
      || as_user meson setup --prefix="$PREFIX" "$SRC_ROOT/ags/build" "$SRC_ROOT/ags"
    as_user env GOTOOLCHAIN=local meson compile -C "$SRC_ROOT/ags/build"
    meson install -C "$SRC_ROOT/ags/build"
  else
    log "ags $have already installed"
  fi
}

step_dropins() {
  local repo
  repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
  for d in "$repo"/systemd/user-dropins/*.service.d; do
    local name; name=$(basename "$d")
    install -d "/etc/systemd/user/$name"
    install -m 644 "$d/hyprland-only.conf" "/etc/systemd/user/$name/hyprland-only.conf"
    log "drop-in /etc/systemd/user/$name/hyprland-only.conf"
  done
}

verify() {
  log "verify:"
  Hyprland --version 2>/dev/null | head -1 || true
  apt-cache policy hyprland | sed -n '1,3p'
  "$PREFIX/bin/ags" --version || true
  ls /usr/share/wayland-sessions/
  cat <<NEXT

Next steps as $TARGET_USER (no root), see hypr/profiles/README-zensid.md:
  ln -sfn ~/home-hyprland/hypr/profiles/zensid.lua ~/.config/hypr/hyprland.lua
  cp  ~/home-hyprland/hypr/{hypridle,hyprpaper}.conf ~/.config/hypr/
  rsync -a --exclude node_modules --exclude @girs ~/home-hyprland/ags/ ~/.config/ags/
  install -m 755 ~/home-hyprland/bin/* ~/.local/bin/
  cp ~/home-hyprland/systemd/user/ags-hyprland.service ~/.config/systemd/user/
  systemctl --user daemon-reload && systemctl --user enable ags-hyprland.service
  # Log out → GDM gear → "Hyprland" (GNOME stays selectable)
NEXT
}

main() {
  preflight
  case "${1:-all}" in
    apt)     step_apt ;;
    build)   step_build ;;
    dropins) step_dropins ;;
    all)     step_apt; step_build; step_dropins ;;
    *) die "unknown step: $1 (apt|build|dropins|all)" ;;
  esac
  verify
}
main "$@"

#!/usr/bin/env python3
"""Drive a mapped Brave window on this Hyprland session (not Cursor's browser).

Playwright-style: screenshot the window, then click in window-local pixels.
Clicks go through Hyprland Lua (cursor.move + mouse:272). No CDP, no restart.

Targets class `brave-browser` only (never Brave PWAs like YouTube).
Prefers titles matching playground / geojson / eudr (override with KDX_BRAVE_TITLE_RE).

  kdx-brave-play status
  kdx-brave-play shot [path]
  kdx-brave-play focus
  kdx-brave-play click <x> <y>     # window-local, origin top-left of the window box
  kdx-brave-play type 'text'
  kdx-brave-play key Return
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

CLASS = "brave-browser"
DEFAULT_TITLE_RE = r"(?i)EUDR"  # Cotton/midraed; override with KDX_BRAVE_TITLE_RE


def ensure_hypr_env() -> None:
    uid = os.getuid()
    os.environ.setdefault("XDG_RUNTIME_DIR", f"/run/user/{uid}")
    os.environ.setdefault("WAYLAND_DISPLAY", "wayland-1")
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    hypr = Path(os.environ["XDG_RUNTIME_DIR"]) / "hypr"
    if not hypr.is_dir():
        raise SystemExit(f"kdx-brave-play: no hypr dir at {hypr}")
    subs = sorted(
        (p for p in hypr.iterdir() if p.is_dir()),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    if not subs:
        raise SystemExit(f"kdx-brave-play: empty hypr dir {hypr}")
    os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = subs[0].name


def hypr_j(cmd: str) -> object:
    return json.loads(
        subprocess.check_output(["hyprctl", "-j", cmd], text=True),
    )


def hypr_eval(code: str) -> str:
    return subprocess.check_output(["hyprctl", "eval", code], text=True).strip()


def title_re() -> re.Pattern[str]:
    raw = os.environ.get("KDX_BRAVE_TITLE_RE") or DEFAULT_TITLE_RE
    return re.compile(raw)


def find_brave() -> dict:
    clients = hypr_j("clients")
    assert isinstance(clients, list)
    matches = [
        c
        for c in clients
        if c.get("class") == CLASS and c.get("mapped")
    ]
    if not matches:
        raise SystemExit("kdx-brave-play: no mapped brave-browser window")
    pat = title_re()
    preferred = [c for c in matches if pat.search(c.get("title") or "")]
    if not preferred and pat.pattern == r"(?i)EUDR":
        fallback = re.compile(r"(?i)(playground|geojson)")
        preferred = [c for c in matches if fallback.search(c.get("title") or "")]
    pool = preferred if preferred else matches
    pool.sort(key=lambda c: int(c.get("focusHistoryID") or 99))
    return pool[0]


def status() -> None:
    win = find_brave()
    monitors = hypr_j("monitors")
    assert isinstance(monitors, list)
    mon = next((m for m in monitors if m.get("id") == win.get("monitor")), None)
    x, y = win["at"]
    w, h = win["size"]
    payload = {
        "rail": "kdx-brave-play",
        "title": win.get("title"),
        "pid": win.get("pid"),
        "address": win.get("address"),
        "workspace": (win.get("workspace") or {}).get("id"),
        "monitor": {
            "id": win.get("monitor"),
            "name": None if mon is None else mon.get("name"),
            "description": None if mon is None else mon.get("description"),
        },
        "box": {"x": x, "y": y, "w": w, "h": h},
        "xwayland": win.get("xwayland"),
        "title_re": os.environ.get("KDX_BRAVE_TITLE_RE") or DEFAULT_TITLE_RE,
        "hypr": os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"),
    }
    json.dump(payload, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")


def focus_brave() -> dict:
    win = find_brave()
    title = (win.get("title") or "").replace("\\", "\\\\").replace('"', '\\"')
    # Prefer exact title among brave-browser windows (avoids YouTube PWAs + wrong Brave).
    result = hypr_eval(
        "local ws = hl.get_windows({ class = \"brave-browser\" }); "
        "if #ws == 0 then error('no brave') end; "
        f'local want = "{title}"; '
        "local pick = ws[1]; "
        "for _, w in ipairs(ws) do if w.title == want then pick = w break end end; "
        "hl.dispatch(hl.dsp.focus({ window = pick })); "
        "return pick.title"
    )
    if "error" in result.lower() and result not in {"ok", win.get("title", "")}:
        raise SystemExit(f"kdx-brave-play focus failed: {result}")
    time.sleep(0.08)
    return win


def shot(path: Path | None) -> Path:
    win = find_brave()
    x, y = win["at"]
    w, h = win["size"]
    if path is None:
        dest_dir = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "kdx-brave"
        dest_dir.mkdir(parents=True, exist_ok=True)
        path = dest_dir / "shot.png"
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
    geom = f"{x},{y} {w}x{h}"
    proc = subprocess.run(["grim", "-g", geom, str(path)], capture_output=True, text=True)
    if proc.returncode != 0:
        raise SystemExit(f"grim failed: {proc.stderr.strip() or proc.returncode}")
    print(path)
    return path


def click_local(lx: int, ly: int) -> None:
    win = focus_brave()
    x, y = win["at"]
    w, h = win["size"]
    if not (0 <= lx < w and 0 <= ly < h):
        raise SystemExit(f"click {lx},{ly} outside window {w}x{h}")
    gx, gy = int(x) + int(lx), int(y) + int(ly)
    hypr_eval(f"hl.dispatch(hl.dsp.cursor.move({{ x = {gx}, y = {gy} }}))")
    time.sleep(0.04)
    hypr_eval(
        'hl.dispatch(hl.dsp.send_key_state({ mods = "", key = "mouse:272", state = "down" }))'
    )
    time.sleep(0.03)
    hypr_eval(
        'hl.dispatch(hl.dsp.send_key_state({ mods = "", key = "mouse:272", state = "up" }))'
    )


def type_text(text: str) -> None:
    focus_brave()
    subprocess.check_call(["wtype", "--", text])


def key(name: str) -> None:
    focus_brave()
    subprocess.check_call(["wtype", "-k", name])


def usage() -> None:
    print(__doc__.strip(), file=sys.stderr)
    raise SystemExit(2)


def main(argv: list[str]) -> None:
    ensure_hypr_env()
    if not argv:
        usage()
    cmd = argv[0]
    if cmd == "status":
        status()
    elif cmd == "focus":
        focus_brave()
    elif cmd == "shot":
        dest = Path(argv[1]) if len(argv) > 1 else None
        shot(dest)
    elif cmd == "click":
        if len(argv) != 3:
            usage()
        click_local(int(argv[1]), int(argv[2]))
    elif cmd == "type":
        if len(argv) < 2:
            usage()
        type_text(" ".join(argv[1:]))
    elif cmd == "key":
        if len(argv) != 2:
            usage()
        key(argv[1])
    else:
        usage()


if __name__ == "__main__":
    main(sys.argv[1:])

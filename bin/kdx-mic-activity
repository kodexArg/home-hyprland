#!/usr/bin/env python3
"""VAD on default mic → stdout "0\\n"/"1\\n". One parec child; killed on exit/signal."""
import math
import os
import signal
import struct
import subprocess
import sys
import time

CHUNK_MS = 40
RATE = 8000
BYTES_PER_SAMPLE = 2
CHUNK_SAMPLES = int(RATE * CHUNK_MS / 1000)
CHUNK_BYTES = CHUNK_SAMPLES * BYTES_PER_SAMPLE
MAX_HANGOVER = 5

_parec = None


def _kill_parec():
    global _parec
    if _parec is None:
        return
    try:
        if _parec.poll() is None:
            _parec.terminate()
            try:
                _parec.wait(timeout=0.5)
            except subprocess.TimeoutExpired:
                _parec.kill()
                _parec.wait(timeout=0.5)
    except Exception:
        try:
            _parec.kill()
        except Exception:
            pass
    _parec = None


def cleanup(*_args):
    _kill_parec()
    sys.exit(0)


signal.signal(signal.SIGINT, cleanup)
signal.signal(signal.SIGTERM, cleanup)


def resolve_source() -> str:
    try:
        output = subprocess.check_output(
            ["pactl", "list", "short", "sources"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
        sources = [
            line.split("\t")[1]
            for line in output.splitlines()
            if len(line.split("\t")) >= 2 and not line.split("\t")[1].endswith(".monitor")
        ]
        if "easyeffects_source" in sources:
            return "easyeffects_source"
        for src in sources:
            if "brio" in src.lower():
                return src
    except Exception:
        pass
    return "@DEFAULT_SOURCE@"


def stream_audio(source: str):
    global _parec
    _kill_parec()
    cmd = [
        "parec",
        f"--rate={RATE}",
        "--channels=1",
        "--format=s16le",
        f"--latency-msec={CHUNK_MS}",
        "-d",
        source,
    ]
    # start_new_session: parent kill leaves us able to signal the session; we still
    # track the Popen and terminate it explicitly (avoids orphan parec on SIGKILL of parent).
    _parec = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    return _parec


def run_vad():
    source = resolve_source()
    proc = stream_audio(source)
    noise_floor = 100.0
    hangover = 0
    last_state = -1

    try:
        while True:
            raw = proc.stdout.read(CHUNK_BYTES)
            if not raw or len(raw) < CHUNK_BYTES:
                break

            samples = struct.unpack(f"<{CHUNK_SAMPLES}h", raw)
            sum_sq = sum(s * s for s in samples)
            rms = math.sqrt(sum_sq / CHUNK_SAMPLES)

            threshold = max(380.0, noise_floor * 1.8)
            is_speech = rms > threshold

            if is_speech:
                hangover = MAX_HANGOVER
            elif hangover > 0:
                hangover -= 1
            else:
                noise_floor = 0.95 * noise_floor + 0.05 * rms

            state = 1 if (is_speech or hangover > 0) else 0

            if state != last_state:
                last_state = state
                sys.stdout.write(f"{state}\n")
                sys.stdout.flush()
    finally:
        _kill_parec()


def main():
    while True:
        try:
            run_vad()
        except Exception:
            _kill_parec()
            time.sleep(1)


if __name__ == "__main__":
    main()

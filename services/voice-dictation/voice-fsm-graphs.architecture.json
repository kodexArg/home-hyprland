  "cards": [
    {
      "dot": "cyan",
      "title": "FSM 1 (Switch) & FSM 2 (Zero-Thought Queue)",
      "items": [
        "FSM 1 (Audio Gate): Toggles microphone hardware capture between muted and continuous 16kHz PCM audio streaming.",
        "FSM 2 (Queue Manager): Silero VAD cuts upon silence; piles successive utterances (pile 1..5) without cognitive reflection.",
        "Dispatch Guard: Emits DISPATCH_CHUNK to FSM 3 ONLY IF Cognitive Brain is in STANDBY (Light Gray). If Brain is busy, the queue holds."
      ]
    },
    {
      "dot": "emerald",
      "title": "FSM 3: Cognitive Brain (Router Without Queue)",
      "items": [
        "Clean Reception: FSM 3 receives a single consolidated chunk without managing buffering or speech slicing.",
        "Action Router: Thinking (:28000) resolves intent into default writing (refined text) or Hyprland actions (workspaces, monitors, Chromium).",
        "Return to Standby: Upon completing execution, Brain returns to Standby and immediately drains any pending chunks in QueueManager."
      ]
    },
    {
      "dot": "amber",
      "title": "Hyprland Router & System Execution",
      "items": [
        "Default Writing: Refines punctuation, casing, and grammar via local LLM before injecting keystrokes with wtype under Audio Lockout.",
        "Hyprland Actions: Dispatches native Lua focus for Workspace 1/2/3, right monitor (HDMI-A-1 AOC), or Chromium stage window (Workspace 4).",
        "Auto-Recovery: Transient LLM timeouts or offline states trigger ERROR (Red) and automatically recover to STANDBY in 3.0 seconds."
      ]
    }
  ]

# Copiar a ~/.config/kodex/local.env (no versionado, propio de cada PC).
# Lo leen Hyprland (hypr/panels.lua) y AGS (widget/local-env.ts).

# Paneles por monitor, izquierda → derecha: "<monitor>:<cantidad>,..."
# <monitor> = conector (hyprctl monitors: name) o "desc:<description>".
# Sin esta línea: HDMI-A-2:3,HDMI-A-1:3.
#   Sid:  KDX_PANELS="desc:ASUSTek COMPUTER INC VA27EHF:3,desc:AOC G2790G4:3"
#   TUF:  KDX_PANELS="eDP-1:1"
#   Zen:  KDX_PANELS="<izquierdo>:1,<derecho>:1"
KDX_PANELS="HDMI-A-2:3,HDMI-A-1:3"

# Ítems de la barra a ocultar, separados por coma:
#   izquierda: volume, game-volume, spotify-volume
#   centro:    panels
#   derecha:   kodexbot, rec-mode, cast-rec, grokbot, grokbuild, cursor,
#              claude, agy, agy-other, openrouter, lanmouse, mic, ram, clock, menu
KDX_BAR_HIDE=""
